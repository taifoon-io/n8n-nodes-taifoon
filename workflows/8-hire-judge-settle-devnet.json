      {
        "parameters": {
          "resource": "handshake",
          "operation": "open",
          "candidateAddress": "={{ $json.candidate }}",
          "candidateKind": "mcp",
          "task": "={{ $json.task }}",
          "openOptions": {
            "args": "={{ JSON.stringify({ chain_id: 8453, block_number: $json.block_number }) }}",
            "chain": "={{ String($json.chainId) }}",
            "dispatch": true,
            "endpoint": "={{ $json.endpoint }}",
