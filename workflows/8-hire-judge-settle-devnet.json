        "id": "n2",
        "name": "Offer + deliver",
        "type": "n8n-nodes-taifoon.taifoon",
        "typeVersion": 1,
        "position": [
          440,
          300
        ],
        "notes": "Offer: the broker opens the handshake and, with dispatch, calls the agent's MCP tool itself. Delivery: the reply comes back with its keccak digest — the evidence the seller seals.",
        "credentials": {
          "taifoonRelayerApi": {
            "id": "taifoon-relayer",
            "name": "Taifoon Relayer API"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "// Delivery: what came back over the wire. No digest = nothing to settle; say why and stop.\nconst r = $input.first().json;\nconst d = r.delivery || {};\nconst digest = d.reply_digest || d.digest || null;\nif (!r.handshake_id) throw new Error('no handshake id in ' + JSON.stringify(r).slice(0, 300));\nif (!digest) throw new Error('no delivery digest: dispatch status ' + (d.status || 'none') + (d.reason ? ' — ' + d.reason : ''));\nreturn [{ json: { handshake_id: r.handshake_id, delivery_status: d.status || null, protocol: d.protocol || null, latency_ms: d.latency_ms ?? null, reply_head: d.reply_head || null, evidence: digest, target: r.target || null } }];"
        },
        "id": "n3",
        "name": "Delivery",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          660,
