            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "n12",
        "name": "Verdict says complete?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          2860,
          300
        ],
        "notes": "The ending follows the verdict. complete → the buyer completes and the payment is captured. reject or needs_review → the job stays funded and submitted on the hook; the evaluator path (bonded judge / challenge) or the buyer's own reject decides it. Money never moves on a verdict that did not say complete."
      },
      {
        "parameters": {
          "jsCode": "// Held: the job is funded and the evidence is sealed; nothing is paid. Say what decides it next.\nconst v = $('Verdict').first().json;\nconst s = $('Settle').first().json;\nreturn [{ json: { held: true, verdict: v.verdict, reasons: v.reasons, next: v.next || (v.verdict === 'reject' ? 'reject: the buyer may reject on chain; the pool pays nothing on a rejection' : 'needs_review: open the evaluator path (bonded judge / challenge); do not auto-settle'), jobId: s.jobId, hook: s.hook, chainId: s.chainId, deadline: s.deadline, what_is_on_chain: 'fundJob (price + premium in escrow, seller deposit locked) and submit (evidence digest sealed); complete/reject not sent' } }];"
        },
        "id": "n13",
        "name": "Held for review",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          3080,
          480
        ]
      }
