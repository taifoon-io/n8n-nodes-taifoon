        "typeVersion": 1,
        "position": [
          1320,
          420
        ],
        "parameters": {
          "operation": "ask",
          "connection": "direct",
          "state": "={{ JSON.stringify($json.jev.state) }}",
          "questions": {},
          "questionsJson": "={{ JSON.stringify($json.jev.questions) }}",
          "routing": "{}",
          "replyLanguage": "off",
          "failClosed": true
        },
        "credentials": {
          "taifoonTypeSafeApi": {
            "id": "tfntypesafe00002",
            "name": "TypeSafe (taifoonTypeSafeApi)"
          }
        },
        "notes": "The instance's own TypeSafe key, used only through this credential. Routing is empty on purpose: the whole distribution goes to the layer, which composes the verdict."
      },
      {
        "name": "Judge · answers",
        "type": "n8n-nodes-taifoon.taifoon",
        "typeVersion": 1,
        "position": [
          1540,
          420
        ],
        "parameters": {
          "resource": "judge",
          "operation": "compose",
          "composeSubject": "handshake",
          "composeHandshakeId": "={{ $('Delivery').first().json.handshake_id }}",
          "composePriceUsdc": 1,
          "composeMode": "answers",
          "composeAnswers": "={{ JSON.stringify($json.answers) }}",
          "composeModel": "={{ $json.model }}",
          "composePrepareDigest": "={{ $('Judge · prepare').first().json.prepare_digest }}",
          "composeAnsweredBy": "n8n-typesafe",
          "composeExecutionId": "={{ $execution.id }}",
          "composeLatencyMs": "={{ $json.latency_ms }}",
          "composeRecord": "devnet"
        },
        "credentials": {
          "taifoonRelayerApi": {
            "id": "tfnrelayerkey001",
            "name": "Taifoon Relayer Key (hire workflow)"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "// The verdict, with what the settlement needs carried forward. Two roads reach here: a hard fail straight from\n// Judge · prepare (the facts decided; Jev was not asked), or Judge · answers (our TypeSafe credential answered, the layer composed).\n// The receipt is the composed verdict: verdict (complete | reject | needs_review), auto, reasons[], receiptHash.\nconst j = $input.first().json;\nconst del = $('Delivery').first().json;\nconst inp = $('Inputs').first().json;\nif (j.ok === false) throw new Error('judge refused: ' + (j.code ? j.code + ': ' : '') + (j.error || JSON.stringify(j).slice(0, 300)));\nconst decision = j.decision || {};\nconst rc = j.receipt || {};\nreturn [{ json: { ...inp, handshake_id: del.handshake_id, evidence: del.evidence, reply_head: del.reply_head, decision_id: decision.id || null, decision_digest: decision.digest || null, decision_anchor: decision.anchor || null, verdict: rc.verdict || null, verdict_auto: rc.auto ?? null, forced: rc.forced || null, reasons: rc.reasons || [], receipt_hash: rc.receiptHash || null, next: j.next || null, judge_called: j.judge_called ?? null, model: j.model || null, judge_latency_ms: j.latency_ms ?? null, answers_source: j.answers_source || null, execution: j.execution || null, prepare_digest: j.prepare_digest || null, quota: j.quota || null } }];"
        },
