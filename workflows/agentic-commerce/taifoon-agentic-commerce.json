        300
      ],
      "parameters": {
        "jsCode": "const h = $json; const input = $('What to do').first().json;\nreturn [{ json: { ...input, handshake: h, ready: h.ok === true && (!h.agreements?.enforced || !h.agreements?.still_missing?.length) } }];"
      }
    },
    {
      "id": "n37",
      "name": "Mode",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "m-chat",
                    "leftValue": "={{ $json.ready ? $json.mode : 'stop' }}",
                    "rightValue": "chat",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "chat"
