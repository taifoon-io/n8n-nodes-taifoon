{
  "name": "n8n-nodes-taifoon",
  "version": "0.1.0",
  "description": "Taifoon n8n community node — cross-chain intelligence, proofs, and assurance receipts",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "taifoon",
    "cross-chain",
    "blockchain",
    "proofs",
    "intel",
    "web3"
  ],
  "license": "MIT",
  "homepage": "https://taifoon.io",
  "author": {
    "name": "Taifoon",
    "email": "dev@taifoon.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taifoon-io/n8n-nodes-taifoon.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "pnpm build && pnpm lint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TaifoonApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Taifoon/Taifoon.node.js",
      "dist/nodes/Taifoon/TaifoonTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
