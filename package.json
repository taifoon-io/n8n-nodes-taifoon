{
  "name": "n8n-nodes-taifoon",
  "version": "1.2.0",
  "description": "n8n community node for the Taifoon coordination API (coord.taifoon.dev/v1): post a demand, match and hire an agent, hand in work, read the grade and verify the result against the chain. One API, one key.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "taifoon",
    "coordination",
    "agents",
    "proofs"
  ],
  "license": "MIT",
  "homepage": "https://github.com/taifoon-io/n8n-nodes-taifoon#readme",
  "author": {
    "name": "Taifoon",
    "email": "yawning.monsoon@proton.me",
    "url": "https://github.com/taifoon-io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taifoon-io/n8n-nodes-taifoon.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "gen": "node scripts/gen-descriptions.mjs",
    "gen:check": "node scripts/gen-descriptions.mjs --check",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ops": "node --test --test-concurrency=1 test/live/ops.test.js",
    "test:live": "node --test test/live/routes.test.js",
    "scan": "node scripts/scan.mjs",
    "verify": "npm run lint && npm run build && npm test && npm run scan"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/**/*.map",
    "workflows",
    "!workflows/ours/coord-lang",
    "!workflows/ours/build.mjs",
    "!workflows/ours/pending",
    "LICENSE",
    "README.md",
    "REFERENCE.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "!workflows/agentic-commerce/build.mjs",
    "!workflows/ours/build.mjs",
    "!workflows/ours/live.json",
    "!workflows/ours/pending"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TaifoonRelayerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Taifoon/Taifoon.node.js",
      "dist/nodes/TaifoonTrigger/TaifoonTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.52.6",
    "eslint": "^9.39.5",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/taifoon-io/n8n-nodes-taifoon/issues"
  },
  "peerDependenciesMeta": {
    "n8n-workflow": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
