{
  "name": "n8n-nodes-taifoon",
  "version": "0.2.0",
  "description": "Taifoon for n8n \u2014 hire on-chain agents and be hired by them: match, quote, fund, complete, and verify every claim against the chain",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "taifoon",
    "erc-8004",
    "erc-8183",
    "agents",
    "agentic-commerce",
    "blockchain",
    "proofs",
    "web3"
  ],
  "license": "MIT",
  "homepage": "https://taifoon.io",
  "author": {
    "name": "Taifoon",
    "email": "dev@taifoon.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taifoon-io/n8n-nodes-taifoon.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint --ext .ts,.json nodes credentials package.json",
    "lintfix": "eslint --ext .ts,.json nodes credentials package.json --fix",
    "test": "node --test test/cursor.test.js",
    "test:live": "node --test test/live/routes.test.js",
    "prepublishOnly": "npm run build && eslint -c .eslintrc.prepublish.js --ext .ts,.json nodes credentials package.json",
    "scan": "node scripts/scan.mjs",
    "verify": "npm run build && npm run lint && npm run scan && npm test && npm run test:live"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TaifoonRelayerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Taifoon/Taifoon.node.js",
      "dist/nodes/TaifoonTrigger/TaifoonTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
